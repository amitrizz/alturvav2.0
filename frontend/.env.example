# Copy to frontend/.env and fill in values

# REQUIRED for mobile wallet connections (Chrome/Safari → WalletConnect deep links)
# 1. Create free project at https://cloud.walletconnect.com
# 2. Add your domain (e.g. kchain.vercel.app) under Project Settings → Domains
# 3. Set the same variable in Vercel → Project → Settings → Environment Variables
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_cloud_project_id

# BSC Testnet RPC (use a reliable public endpoint)
VITE_BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com

# Optional: referral link encryption key
VITE_REFERRAL_KEY=your_referral_encryption_key
